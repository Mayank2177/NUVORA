NUVORA_ENVIRONMENT=production
NUVORA_HOST=0.0.0.0
NUVORA_PORT=4117
NUVORA_SECRET_KEY=GENERATE_32+_RANDOM_CHARS
NUVORA_ENCRYPTION_KEY=GENERATE_DIFFERENT_32+_RANDOM_CHARS
NUVORA_PUBLIC_BASE_URL=https://app.example.com
NUVORA_FRONTEND_BASE_URL=https://app.example.com
NUVORA_ENABLE_CORS=true
NUVORA_CORS_ORIGINS=https://app.example.com
NUVORA_DATABASE_POOL_MIN_SIZE=2
NUVORA_DATABASE_POOL_SIZE=20
NUVORA_RATE_LIMIT_ENABLED=true
NUVORA_TRUSTED_PROXY_IPS=
NUVORA_TOKEN_TTL_HOURS=168
NUVORA_GITHUB_CLIENT_ID=REPLACE
NUVORA_GITHUB_CLIENT_SECRET=REPLACE
NUVORA_GITHUB_REDIRECT_URI=https://app.example.com/api/auth/github/callback
NUVORA_GITHUB_WEBHOOK_SECRET=GENERATE_RANDOM
NUVORA_SMTP_HOST=smtp.example.com
NUVORA_SMTP_PORT=587
NUVORA_SMTP_USER=REPLACE
NUVORA_SMTP_PASSWORD=REPLACE
NUVORA_SMTP_FROM_EMAIL=noreply@example.com
NUVORA_SEED_DEMO=false
# NUVORA_DATABASE_URL and NUVORA_RATE_LIMIT_REDIS_URL are injected by compose.yaml
