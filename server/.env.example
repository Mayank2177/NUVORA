NUVORA_ENVIRONMENT=development
NUVORA_HOST=127.0.0.1
NUVORA_PORT=4117
NUVORA_LOG_LEVEL=INFO
NUVORA_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
NUVORA_ENCRYPTION_KEY=change-me-to-a-different-random-string-32-chars
NUVORA_PUBLIC_BASE_URL=http://localhost:3000
NUVORA_FRONTEND_BASE_URL=http://localhost:3000
NUVORA_DATABASE_PATH=data/nuvora.sqlite3
NUVORA_ENABLE_CORS=true
NUVORA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
NUVORA_RATE_LIMIT_ENABLED=false
NUVORA_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
NUVORA_TOKEN_TTL_HOURS=168
# Copy these settings to the project-root .env. Use an App Password, not the account password.
NUVORA_SMTP_HOST=smtp.gmail.com
NUVORA_SMTP_PORT=587
NUVORA_SMTP_USER=email_address
NUVORA_SMTP_PASSWORD=
NUVORA_SMTP_FROM_EMAIL=email_address
NUVORA_SMTP_FROM_NAME=NUVORA
NUVORA_GITHUB_CLIENT_ID=id from oauth app
NUVORA_GITHUB_CLIENT_SECRET=
NUVORA_GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
FRONTEND_URL=http://localhost:3000
GITHUB_TOKEN_ENCRYPTION_KEY=
NUVORA_GITHUB_WEBHOOK_SECRET=your_webhook_secret
NUVORA_DATABASE_URL=