NUVORA_ENVIRONMENT=development
NUVORA_HOST=127.0.0.1
NUVORA_PORT=4117
NUVORA_LOG_LEVEL=INFO
NUVORA_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
NUVORA_ENCRYPTION_KEY=change-me-to-a-different-random-string-32-chars
NUVORA_PUBLIC_BASE_URL=http://localhost:3000
NUVORA_FRONTEND_BASE_URL=http://localhost:3000
NUVORA_DATABASE_PATH=data/.sqlite3
NUVORA_ENABLE_CORS=true
NUVORA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NUVORA_RATE_LIMIT_ENABLED=false
NUVORA_TOKEN_TTL_HOURS="add_hours"
NUVORA_SEED_DEMO=false
NUVORA_GITHUB_CLIENT_ID="create_client_id"
NUVORA_GITHUB_CLIENT_SECRET="generate_secret_key"
GITHUB_REDIRECT_URI="add_callback_url"
GITHUB_TOKEN_ENCRYPTION_KEY=change-me-to-a-different-random-string-32-chars
